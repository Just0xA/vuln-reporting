# .gitattributes — release-tarball boundary (FOOT-01..04)
#
# Defines which paths are stripped from `git archive HEAD` output (the
# canonical release tarball, including the source tarball attached to a
# GitHub Release). Rules below use per-path `export-ignore` only; no other
# attribute types are defined here (no text=, no linguist-*).
#
# IMPORTANT: `git archive HEAD` reads from the committed tree at HEAD and
# ignores both the working tree and the index. This file must be COMMITTED
# for any rule below to take effect. `git add` alone is not sufficient, and
# `--worktree-attributes` does NOT cover `export-ignore`.

# -----------------------------------------------------------------------
# Dev/planning directories — never shipped to release consumers
# -----------------------------------------------------------------------
.planning/      export-ignore
docs/           export-ignore
ref/            export-ignore
tests/          export-ignore
.github/        export-ignore

# -----------------------------------------------------------------------
# Dev-only root docs
# -----------------------------------------------------------------------
CLAUDE.md       export-ignore
RUNBOOK.md      export-ignore
CONTRIBUTING.md export-ignore

# -----------------------------------------------------------------------
# Named dev-only scripts (FOOT-02)
#
# Script exclusions are by EXPLICIT NAME (not wildcard over `scripts/`).
# Phase 8 `scripts/warm_cache.py` and Phase 10 `scripts/update_from_github.sh`
# ship in the tarball automatically — only files matching the patterns below
# are excluded. The `scripts/smoke_*` pattern intentionally has no `.py`
# suffix so future non-Python smoke scripts (shell, etc.) are also covered.
# -----------------------------------------------------------------------
scripts/setup_github_labels.py  export-ignore
scripts/smoke_*                 export-ignore

# -----------------------------------------------------------------------
# Belt-and-suspenders for gitignored runtime paths
#
# These are already in `.gitignore` so they should not be tracked, but list
# them here too in case a runtime artifact ever gets committed accidentally —
# it still must not leak into the release tarball.
# -----------------------------------------------------------------------
data/trend/     export-ignore
data/cache/     export-ignore
output/         export-ignore
logs/           export-ignore

# -----------------------------------------------------------------------
# Repo-management files
#
# Exclude this file itself so the release tarball never carries its own
# boundary definition (release consumers don't need export-ignore rules —
# they consume a tarball, they do not re-archive it).
# -----------------------------------------------------------------------
.gitattributes  export-ignore
.gitignore      export-ignore
.claude/        export-ignore
.cursor/        export-ignore
.codex/         export-ignore
.agents/        export-ignore
