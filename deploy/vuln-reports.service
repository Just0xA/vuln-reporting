# /etc/systemd/system/vuln-reports.service
#
# Systemd unit file for the Vulnerability Management Report Scheduler.
# Runs scheduler.py --mode daemon as a long-lived background service.
#
# Installation (run as root):
#   sudo cp deploy/vuln-reports.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vuln-reports
#   sudo systemctl start vuln-reports
#   sudo systemctl status vuln-reports
#
# Logs:
#   sudo journalctl -u vuln-reports -f
#   sudo journalctl -u vuln-reports --since "1 hour ago"
#
# Install base path:
#   This unit assumes the install base is /opt/vuln-reporting. systemd cannot
#   expand environment variables in WorkingDirectory, EnvironmentFile, or
#   ReadWritePaths (they are parsed before any environment is loaded), so the
#   base path is hard-coded below. To relocate the install (e.g. to
#   /opt/storage/vuln-reporting), rewrite every base path in this file
#   consistently before installing it, for example:
#     sudo sed -i 's#/opt/vuln-reporting#/opt/storage/vuln-reporting#g' \
#       /etc/systemd/system/vuln-reports.service
#   and set INSTALL_ROOT to the same base when invoking update_from_github.sh
#   (see DEPLOYMENT.md "Relocating the install base").

[Unit]
Description=Vulnerability Management Report Scheduler
After=network.target
Wants=network-online.target

[Service]
# -----------------------------------------------------------------------
# Identity — run as a dedicated non-login service account, never as root
# -----------------------------------------------------------------------
User=vuln-reports
Group=vuln-reports

# -----------------------------------------------------------------------
# Working directory and environment
# -----------------------------------------------------------------------
WorkingDirectory=/opt/vuln-reporting/current/

# Load credentials from .env file.
# All SMTP_* and TVM_* variables defined in .env are injected into the
# process environment.  Never commit .env to version control.
EnvironmentFile=/opt/vuln-reporting/shared/.env

# Runtime cache home for libraries that write dotfiles/caches under $HOME.
# The service account is created with --no-create-home, so HOME would
# otherwise be unwritable. Under ProtectSystem=strict (below) the parent
# tree is read-only, so these MUST point at a path that is both inside
# ReadWritePaths and pre-created at install time:
#   - HOME            — generic fallback for any library probing ~
#   - XDG_CACHE_HOME  — WeasyPrint/fontconfig font cache ($HOME/.cache)
#   - MPLCONFIGDIR    — matplotlib config/cache (auto-creates this subdir,
#                       since its parent runtime-cache/ is writable)
Environment=HOME=/opt/vuln-reporting/shared/data/runtime-cache
Environment=XDG_CACHE_HOME=/opt/vuln-reporting/shared/data/runtime-cache
Environment=MPLCONFIGDIR=/opt/vuln-reporting/shared/data/runtime-cache/matplotlib

# -----------------------------------------------------------------------
# Execution
# -----------------------------------------------------------------------
ExecStart=/opt/vuln-reporting/current/.venv/bin/python scheduler.py --mode daemon

# Attempt a clean reload by sending SIGTERM and waiting for the process
# to exit gracefully (scheduler.py catches SIGTERM and waits for any
# in-progress report job to finish before exiting).
KillSignal=SIGTERM
TimeoutStopSec=120

# -----------------------------------------------------------------------
# Restart policy — recover automatically from crashes
# -----------------------------------------------------------------------
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# -----------------------------------------------------------------------
# Logging — stdout and stderr are captured by journald automatically
# -----------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vuln-reports

# -----------------------------------------------------------------------
# Security hardening (RHEL 9 / systemd 252+)
# -----------------------------------------------------------------------
# Prevent the process from gaining additional privileges
NoNewPrivileges=true

# Give the service a private /tmp
PrivateTmp=true

# Make the entire OS file tree (including /opt) read-only, except the paths
# enumerated in ReadWritePaths below. Without ProtectSystem, ReadWritePaths
# is inert — the whole filesystem stays writable and the write sandbox is a
# no-op. 'strict' (not 'full') is required because 'full' leaves /opt
# writable, which is exactly where this install lives.
ProtectSystem=strict

# Allow network access (required for Tenable API and SMTP delivery)
# PrivateNetwork is NOT set so that outbound connections work.

# Restrict write access: only the shared runtime paths are writable.
# These are the persistent directories under /opt/vuln-reporting/shared/
# (the release-agnostic side of the symlink-based deploy layout) — the
# release tree under /opt/vuln-reporting/current/ is intentionally read-only.
# runtime-cache holds the HOME/XDG_CACHE_HOME/MPLCONFIGDIR writes above and
# MUST exist before start (systemd fails namespace setup on a missing RWP
# path under ProtectSystem=strict; the install layout creates it).
ReadWritePaths=/opt/vuln-reporting/shared/output /opt/vuln-reporting/shared/logs /opt/vuln-reporting/shared/data/cache /opt/vuln-reporting/shared/data/trend /opt/vuln-reporting/shared/data/runtime-cache

[Install]
WantedBy=multi-user.target
